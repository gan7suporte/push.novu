# Variáveis da stack Novu no Portainer
# Gere os segredos com: bash gerar-env.sh http://IP_OU_DOMINIO

# Endereço pelo qual os navegadores e sistemas acessam o servidor (sem porta e sem barra no final)
# Ex.: http://192.168.0.10  ou  https://novu.empresa.com.br
NOVU_HOST=

# Portas publicadas no servidor
API_PORT=3000
WS_PORT=3002
DASHBOARD_PORT=4000

# Versão das imagens do Novu
NOVU_VERSION=3.19.0

# production = CORS restrito ao Dashboard | local = CORS liberado
NODE_ENV=production

# Segredos — NUNCA reutilize entre ambientes
# JWT_SECRET / NOVU_SECRET_KEY: openssl rand -hex 32
# STORE_ENCRYPTION_KEY: exatamente 32 caracteres (openssl rand -hex 16).
#   Não troque depois de cadastrar provedores: as credenciais salvas ficam ilegíveis.
JWT_SECRET=
STORE_ENCRYPTION_KEY=
NOVU_SECRET_KEY=

# MongoDB — usuário/senha só são aplicados na PRIMEIRA criação do volume
MONGO_USER=novu
MONGO_PASSWORD=

# Armazenamento S3 (opcional — só necessário para anexos)
S3_LOCAL_STACK=
S3_BUCKET_NAME=novu-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
